---
import Base from "../layouts/Base.astro";
import Slideshow from "../components/Slideshow.astro";
import Palette from "../components/Palette.astro";
import profile from "../content/profile.json";
import experience from "../content/experience.json";
import projects from "../content/projects.json";
import other from "../content/other.json";
import friends from "../content/friends.json";
import * as simpleIcons from "simple-icons";

const skills = profile.skills.map((s) => ({ ...s, path: (simpleIcons as any)[s.icon]?.path as string | undefined }));

const posts = Object.values(import.meta.glob("../content/posts/*.md", { eager: true })) as any[];
const published = posts.filter((p) => p.frontmatter?.published !== false);

const sections = [
  { id: "about", label: "about" },
  { id: "experience", label: "experience" },
  { id: "projects", label: "projects" },
  { id: "other", label: "other stuff" },
  { id: "friends", label: "friends" },
  ...(published.length ? [{ id: "writing", label: "writing" }] : []),
];

const featured = projects.filter((p) => p.featured);
const more = projects.filter((p) => !p.featured);
const slides = [...featured, ...more];
const otherSorted = [...other].sort((a, b) => a.start.localeCompare(b.start));
const pad = (n: number) => String(n).padStart(2, "0");
const deployed = new Date().toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "America/New_York" }).toLowerCase();
// envelope marks for the email icon: shut by default, lid up on hover
const mailShut = "M2 6.6A2.6 2.6 0 014.6 4h14.8A2.6 2.6 0 0122 6.6v10.8a2.6 2.6 0 01-2.6 2.6H4.6A2.6 2.6 0 012 17.4V6.6zm2.9-.4L12 11.9l7.1-5.7H4.9z";
const mailOpen = "M12 2.4l10 7.2v7.8a2.6 2.6 0 01-2.6 2.6H4.6A2.6 2.6 0 012 17.4V9.6l10-7.2zm0 2.5L4.8 10.1 12 15.2l7.2-5.1L12 4.9z";
// simple-icons dropped LinkedIn, so its mark is inlined here
const linkedin = "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z";
const social = profile.links.map((l) => ({ ...l, path: l.icon === "linkedin" ? linkedin : ((simpleIcons as any)[l.icon]?.path as string | undefined) }));
---
<Base>
  <div class="topbar mono">
    <a href="#top">~/jossaya</a>
    <button data-open-palette>menu ⌘</button>
  </div>

  <div class="wrap">
    <aside class="side">
      <img class="photo" src={profile.photo} alt={profile.photoAlt} width="120" height="120" />
      <h1 class="name mono"><span data-type={profile.typing ? profile.name : undefined}>{profile.name}</span><span class="cursor" aria-hidden="true"></span></h1>
      <p class="currently">{profile.currently}</p>

      <nav class="toc mono" aria-label="sections">
        <ul>
          {sections.map((s) => (
            <li><a href={`#${s.id}`} data-nav={s.id}><span class="bar"></span>{s.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="side-foot">
        <div class="mail" data-mail>
          <ul class="socials">
            {social.map((l) => (
              <li><a href={l.url} target="_blank" rel="noopener" aria-label={l.label} title={l.display}>
                {l.path
                  ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d={l.path} /></svg>
                  : <span class="mono">{l.label}</span>}
              </a></li>
            ))}
            <li>
              <button class="env" data-copy={profile.email} data-quiet aria-label="copy email address">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill-rule="evenodd">
                  <path class="shut" d={mailShut} />
                  <path class="open" d={mailOpen} />
                </svg>
              </button>
            </li>
          </ul>
          <div class="card mono" aria-hidden="true">
            <span class="addr">
              <span class="a">{profile.email}</span>
              <span class="b">click to copy</span>
            </span>
            <span class="done">copied</span>
          </div>
        </div>
        <figure class="verse">
          <blockquote>{profile.verse.text}</blockquote>
          <figcaption class="mono">{profile.verse.ref}</figcaption>
        </figure>
        <button class="hint mono" data-open-palette><kbd>⌘K</kbd> jump anywhere, right-click for more</button>
      </div>
    </aside>

    <main class="main">
      <div class="screen" data-screen>
        <section id="about" data-section>
          <h2 class="label mono fade">about</h2>
          {profile.about.map((p, i) => <p class="fade" style={`--i:${i + 1}`}>{p}</p>)}
          <ul class="skills fade" style="--i:3" aria-label="skills">
            {skills.map((k) => (
              <li>
                {k.path && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={k.path} /></svg>}
                <span class="mono">{k.name}</span>
              </li>
            ))}
          </ul>
          <p class="reach mono fade" style="--i:4">
            <a class="accent" href={profile.resume} download>see my resume ↗</a>
          </p>
        </section>
      </div>

      <div class="screen" data-screen>
        <section id="experience" data-section>
          <h2 class="label mono fade">experience</h2>
          <ol class="exp">
            {experience.map((e, i) => (
              <li class="fade" style={`--i:${i + 1}`}>
                <span class="date mono">{e.dates}</span>
                <div>
                  <h3>{e.role} <span class="at">@</span> {e.url
                    ? <a class="org" href={e.url} target="_blank" rel="noopener">{e.org}<span class="arr"> ↗</span></a>
                    : <span class="org">{e.org}</span>}</h3>
                  <p>{e.summary}</p>
                  <p class="tags mono">{e.tags.map((t) => `#${t}`).join(" ")}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      </div>

      <div class="screen" data-screen>
        <section id="projects" data-section>
          <h2 class="label mono fade">projects</h2>
          <div class="fade" style="--i:1">
            <Slideshow label="projects" count={slides.length} groups={[featured.length, more.length].filter(Boolean)}>
              {slides.map((p, i) => (
                <article class="slide project">
                  {p.image ? (
                    <div class="frame">
                      <img data-src={p.image} alt={p.alt} width="1200" height="750" decoding="async" />
                      <span class="badge mono">{pad(i + 1)}</span>
                    </div>
                  ) : <span class="badge static mono">{pad(i + 1)}</span>}
                  <h3>
                    {p.url ? <a href={p.url} target="_blank" rel="noopener">{p.title} <span class="arr">↗</span></a> : p.title}
                    {p.year && <span class="year mono">{p.year}</span>}
                  </h3>
                  {p.context && <p class="context mono">{p.context}</p>}
                  {p.description && <p>{p.description}</p>}
                  {p.links?.length ? <p class="extra mono">{p.links.map((l) => <a class="link" href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}</p> : null}
                  {p.tags.length ? <p class="tags mono">{p.tags.map((t) => `#${t}`).join(" ")}</p> : null}
                </article>
              ))}
            </Slideshow>
          </div>
        </section>
      </div>

      <div class="screen" data-screen>
        <section id="other" data-section>
          <h2 class="label mono fade">other stuff i'm up to</h2>
          <ol class="exp light">
            {otherSorted.map((o, i) => (
              <li class="fade" style={`--i:${i + 1}`}>
                <span class="date mono">{o.dates}</span>
                <div>
                  <h3>{o.url
                    ? <a class="role" href={o.url} target="_blank" rel="noopener">{o.role} ↗</a>
                    : <span class="role">{o.role}</span>}{o.org && <> <span class="at">@</span> <span class="org">{o.org}</span></>}</h3>
                  <p>{o.line}{o.live && <> <a class="link mono live" href={o.live} target="_blank" rel="noopener">{o.live.replace("https://", "")}</a></>}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      </div>

      <div class="screen" data-screen>
        <section id="friends" data-section>
          <h2 class="label mono fade">friends</h2>
          <p class="intro fade" style="--i:1">{friends.intro}</p>
          <ul class="friends fade" style="--i:2">
            {friends.people.map((f) => (
              <li>
                <span class="fname">{f.name}</span>
                <span class="fline">{f.line}</span>
                <a class="link mono" href={f.url} target="_blank" rel="noopener">{f.url.replace("https://", "")} ↗</a>
              </li>
            ))}
          </ul>
          {friends.photo && (
            <img class="fade photo-one" style="--i:3" src={friends.photo.image} alt={friends.photo.alt} width="1296" height="972" loading="lazy" decoding="async" />
          )}
        </section>

        {published.length > 0 && (
          <section id="writing" data-section>
            <h2 class="label mono fade">writing</h2>
            <ul class="posts">
              {published.map((p) => <li class="fade"><span class="date mono">{p.frontmatter.date}</span> {p.frontmatter.title}</li>)}
            </ul>
          </section>
        )}

        <footer class="footer mono">
          <p>made with ❤️ by {profile.name}</p>
          <p><a class="link" href={profile.source} target="_blank" rel="noopener">view source on github</a></p>
          <p class="dim">last deployed {deployed}</p>
        </footer>
      </div>
    </main>
  </div>

  <Palette sections={sections} />

  <script>
    import "../scripts/main";
  </script>
</Base>

<style>
  .wrap { max-width: 1280px; margin: 0 auto; padding: 0 48px; display: grid; grid-template-columns: 440px minmax(0, 648px); justify-content: space-between; column-gap: 48px; }
  .side { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; padding: 96px 0 48px; }
  .photo { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; }
  .name { font-size: 34px; font-weight: 700; line-height: 1.2; margin: 28px 0 8px; letter-spacing: -.01em; white-space: nowrap; }
  .currently { margin: 0; color: var(--muted); font-size: 15px; }
  .toc { margin-top: 56px; font-size: 13px; }
  .toc ul, .socials, .friends, .exp, .posts { list-style: none; margin: 0; padding: 0; }
  .toc a { display: flex; align-items: center; height: 30px; color: var(--dim); transition: color .25s ease-out; }
  .toc a:hover { color: var(--muted); }
  .toc .bar { display: block; height: 1px; width: 0; background: var(--text); margin-right: 0; transition: width .25s ease-out, margin-right .25s ease-out; }
  .toc a.active { color: var(--text); }
  .toc a.active .bar { width: 40px; margin-right: 14px; }
  .side-foot { margin-top: auto; }
  .socials { display: flex; gap: 22px; color: var(--muted); }
  .socials a { display: block; color: inherit; transition: color .2s; }
  .socials a:hover { color: var(--accent); }
  .socials svg { width: 26px; height: 26px; fill: currentColor; display: block; }

  /* email: a shut envelope that opens on hover and shows the address.
     Clicking copies - the card snaps to green "copied", then fades back. */
  .env { display: block; color: inherit; transition: color .2s; }
  .env .shut, .env .open { transition: opacity .18s ease; }
  .env .open { opacity: 0; }
  .mail.open .env { color: var(--accent); }
  .mail.open .shut { opacity: 0; }
  .mail.open .open { opacity: 1; }
  .card { display: grid; margin-top: 12px; min-height: 36px; opacity: 0; pointer-events: none; color: var(--muted); transition: opacity .22s ease; }
  .card > * { grid-area: 1 / 1; }
  .mail.open .card, .mail.copied .card { opacity: 1; }
  .addr { display: flex; flex-direction: column; line-height: 1.5; }
  .addr .a { font-size: 13px; }
  .addr .b { font-size: 11px; color: var(--dim); }
  .done { font-size: 13px; color: var(--ok); opacity: 0; }
  .card .addr, .card .done { transition: opacity .3s ease; }
  .mail.copied .addr { opacity: 0; }
  .mail.copied .done { opacity: 1; }
  .mail.copied .env { color: var(--ok); }
  .mail.copied .addr, .mail.copied .done, .mail.copied .env { transition: none; }
  .accent { color: var(--accent); }
  .verse { margin: 32px 0 20px; max-width: 340px; }
  .verse blockquote { margin: 0; font-style: italic; font-size: 13px; line-height: 1.55; color: var(--muted); }
  .verse figcaption { margin-top: 6px; font-size: 11px; color: var(--dim); }
  .hint { font-size: 11px; color: var(--dim); border: 1px solid var(--line); border-radius: 4px; padding: 6px 10px; transition: color .2s; text-align: left; }
  .hint:hover { color: var(--muted); }
  .hint kbd { font: inherit; color: var(--muted); margin-right: 8px; }

  .main { padding: 0 0 48px; }
  .screen { min-height: 100vh; padding: 96px 0 64px; }
  section + section { margin-top: 64px; }
  .label { margin: 0 0 20px; font-size: 13px; font-weight: 400; color: var(--accent); }
  section p { margin: 0 0 16px; color: #bdbdc5; }
  .reach { margin: 28px 0 0 !important; padding-top: 18px; border-top: 1px solid var(--line); font-size: 13px; }
  .reach a.accent:hover { opacity: .8; }
  .skills { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(76px, 1fr)); gap: 18px 8px; }
  .skills li { display: flex; flex-direction: column; align-items: center; gap: 8px; color: var(--muted); transition: color .2s; }
  .skills li:hover { color: var(--accent); }
  .skills svg { width: 22px; height: 22px; fill: currentColor; }
  .skills span { font-size: 11px; color: var(--dim); white-space: nowrap; }
  .skills li:hover span { color: var(--muted); }
  .link { color: var(--text); transition: color .2s; }
  .link:hover { color: var(--accent); }

  .exp > li { display: grid; grid-template-columns: 168px 1fr; gap: 24px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .date { font-size: 12px; color: var(--dim); padding-top: 4px; }
  .exp h3 { margin: 0 0 6px; font-size: 16px; font-weight: 500; color: var(--text); }
  .at { color: var(--dim); }
  .org { color: var(--accent); }
  .arr { opacity: 0; transition: opacity .2s; }
  a:hover .arr { opacity: 1; }
  .exp p { margin: 0 0 8px; font-size: 15px; }
  .tags { font-size: 12px; color: var(--dim) !important; margin: 0 !important; }
  .light > li { border: 0; padding: 14px 0; }
  .light .role { color: var(--soft); transition: color .2s; }
  .light a.role:hover { color: var(--accent); }
  .light .org { color: var(--muted); }
  .light p { color: var(--muted); }
  .live { font-size: 12px; color: var(--dim); }

  .frame { position: relative; }
  .frame img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 6px; background: var(--surface); }
  .badge { position: absolute; top: 12px; right: 12px; font-size: 11px; color: var(--text); background: rgb(11 11 13 / .8); border: 1px solid var(--line); border-radius: 4px; padding: 2px 7px; }
  .project h3 { margin: 20px 0 4px; font-size: 18px; font-weight: 500; display: flex; align-items: baseline; gap: 12px; }
  .project h3 a:hover { color: var(--accent); }
  .year { font-size: 12px; color: var(--dim); font-weight: 400; }
  .context { font-size: 13px; color: var(--accent) !important; margin-bottom: 8px !important; }
  .project p { font-size: 15px; margin-bottom: 8px; }
  .extra { display: flex; gap: 16px; font-size: 12px; }

  .intro { color: var(--muted) !important; }
  .friends li { display: grid; grid-template-columns: 168px 1fr auto; gap: 16px; padding: 10px 0; align-items: baseline; font-size: 15px; }
  .fname { color: var(--text); }
  .fline { color: var(--muted); }
  .friends .link { font-size: 12px; color: var(--muted); }
  .photo-one { margin-top: 40px; width: 100%; height: auto; border-radius: 6px; background: var(--surface); }
  .badge.static { position: static; display: inline-block; }

  .footer { margin-top: 96px; font-size: 12px; color: var(--muted); }
  .footer p { margin: 0 0 6px; color: inherit; }
  .dim { color: var(--dim) !important; }

  .topbar { display: none; }

  /* wheel mode (desktop): screens are stacked on a vertical strip, like a
     painted wheel seen face-on. Turning it slides the old screen up and out
     while the next one rises in from below (flat, no tilt or depth). */
  :global(html.wheel), :global(html.wheel body) { height: 100%; overflow: hidden; }
  :global(html.wheel) .main { position: relative; height: 100vh; padding: 0; }
  :global(html.wheel) .screen {
    position: absolute; inset: 0; min-height: 0; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none;
    transition: transform .62s cubic-bezier(.22,.8,.24,1), opacity .5s ease;
    opacity: 0; visibility: hidden;
  }
  :global(html.wheel) .screen::-webkit-scrollbar { display: none; }
  .screen:focus { outline: none; }
  :global(html.wheel) .screen.above { transform: translateY(-55vh); }
  :global(html.wheel) .screen.below { transform: translateY(55vh); }
  :global(html.wheel) .screen.cur { transform: none; opacity: 1; visibility: visible; transition: transform .62s cubic-bezier(.22,.8,.24,1), opacity .4s ease .04s; }
  :global(html.wheel) .screen:not(.cur) { transition: transform .62s cubic-bezier(.22,.8,.24,1), opacity .3s ease, visibility 0s linear .62s; }

  @media (max-width: 1023px) {
    .topbar { display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 10; height: 52px; padding: 0 20px; background: rgb(11 11 13 / .92); border-bottom: 1px solid var(--line); font-size: 13px; color: var(--muted); }
    .wrap { display: block; padding: 0 20px; }
    .side { position: static; height: auto; padding: 36px 0 8px; }
    .photo { width: 88px; height: 88px; }
    .name { font-size: 26px; margin-top: 20px; }
    .toc { display: none; }
    .side-foot { margin-top: 24px; }
    .socials { flex-wrap: wrap; gap: 16px; }
    .verse { margin: 28px 0 0; }
    .hint { display: none; }
    .screen { min-height: 0; padding: 56px 0 0; }
    section { scroll-margin-top: 64px; }
    .exp > li { grid-template-columns: 1fr; gap: 6px; }
    .friends li { grid-template-columns: 1fr; gap: 2px; padding: 12px 0; }
    .footer { margin: 72px 0 24px; }

    /* screen mode on phones: the header and each screen fill the space under the top bar */
    :global(html.wheel) .wrap { position: relative; height: calc(100dvh - 52px); padding: 0; }
    :global(html.wheel) .main { position: static; height: auto; }
    :global(html.wheel) .screen { padding: 36px 20px 48px; }
    :global(html.wheel) .side.screen { display: flex; flex-direction: column; justify-content: center; }
  }

  /* tablets / wide windows on the stacked layout: center the header screen */
  @media (min-width: 600px) and (max-width: 1023px) {
    .side { align-items: center; text-align: center; }
    .side-foot { display: flex; flex-direction: column; align-items: center; }
    .socials { justify-content: center; }
    .verse { margin-left: auto; margin-right: auto; }
    /* keep sections to a readable column instead of stretching edge to edge */
    .screen > :global(*) { max-width: 640px; margin-left: auto; margin-right: auto; }
  }
</style>
