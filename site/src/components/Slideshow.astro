---
// Crossfading slideshow shared by projects and friend photos.
// Slides are passed as children (.slide elements); `groups` splits the dots
// into a featured group and a "more" group.
interface Props { label: string; count: number; groups?: number[] }
const { label, count, groups = [count] } = Astro.props;
let n = 0;
const dotGroups = groups.map((size) => Array.from({ length: size }, () => n++));
---
<div class="show" data-show aria-roledescription="carousel" aria-label={label}>
  <div class="stage" data-stage aria-live="polite">
    <slot />
  </div>
  <div class="nav mono">
    <button class="arrow" data-prev aria-label="previous slide">←</button>
    <div class="dots">
      {dotGroups.map((group) => (
        <span class="group">
          {group.map((i) => (
            <button class="dot" data-dot={i} aria-label={`slide ${i + 1} of ${count}`}><span class="fill"></span></button>
          ))}
        </span>
      ))}
    </div>
    <button class="arrow" data-next aria-label="next slide">→</button>
  </div>
</div>

<style>
  .stage { display: grid; grid-template-columns: minmax(0, 1fr); touch-action: pan-y; }
  .stage > :global(.slide) { grid-area: 1 / 1; opacity: 0; visibility: hidden; transition: opacity .5s ease, visibility 0s linear .5s; }
  .stage > :global(.slide.on) { opacity: 1; visibility: visible; transition: opacity .5s ease; }
  .nav { display: flex; align-items: center; gap: 18px; margin-top: 22px; color: var(--muted); font-size: 13px; }
  .arrow { padding: 4px 6px; color: var(--muted); transition: color .2s; }
  .arrow:hover { color: var(--text); }
  .dots { display: flex; gap: 16px; }
  .group { display: flex; gap: 7px; align-items: center; }
  .dot { position: relative; width: 6px; height: 6px; border-radius: 3px; background: var(--line); overflow: hidden; transition: width .25s ease-out, background .2s; }
  .dot:hover { background: var(--dim); }
  .dot[aria-current="true"] { width: 28px; background: var(--line); }
  .fill { position: absolute; inset: 0; width: 0; background: var(--accent); }
  .dot[aria-current="true"] .fill { animation: fill 6s linear forwards; }
  .show.paused .dot[aria-current="true"] .fill { animation-play-state: paused; }
  @keyframes fill { to { width: 100%; } }
</style>

<script>
  import { initSlideshows } from "../scripts/slideshow";
  initSlideshows();
</script>
